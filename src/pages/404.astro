---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNavCourses } from "@/lib/courses";
import NotFound from "@/screens/NotFound";
import HomeNavigation from "@/components/home/HomeNavigation";
import WhatsAppButton from "@/components/WhatsAppButton";
import { WS_FONT_UI } from "@/components/workshop/workshop-styles";

const navCourses = await getNavCourses();
// Cuando un curso inexistente o inactivo se reescribe a /404, `originPathname` conserva la ruta pedida (va en el buscador).
const requestedPath = (Astro.originPathname ?? Astro.url.pathname).replace(/(.)\/$/, "$1");
---

<BaseLayout
  title="Página no encontrada (404) | Joaquín C. Dev"
  description="La página que buscas no existe. Vuelve al inicio para explorar los cursos de Java y programación."
  noindex={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&display=swap"
    />
  </Fragment>
  <!-- HTML sin hidratar; solo el menú y el botón de WhatsApp cargan React. -->
  <div class={`${WS_FONT_UI} min-h-screen overflow-x-clip bg-[#0b0d10] text-[#eceef1] antialiased`}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-[#0b0d10]"
    >
      Saltar al contenido
    </a>
    <HomeNavigation client:load navCourses={navCourses} pathname={Astro.url.pathname} />
    <NotFound navCourses={navCourses} requestedPath={requestedPath} />
    <WhatsAppButton client:idle autoOpen={false} />
  </div>
</BaseLayout>
