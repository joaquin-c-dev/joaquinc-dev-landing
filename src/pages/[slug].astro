---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCourseBySlug, getNavCourses } from "@/lib/courses";
import { formatSeoKeywords } from "@/lib/course-formatters";
import CoursePage from "@/screens/CoursePage";

const { slug } = Astro.params;
const [course, navCourses] = await Promise.all([
  getCourseBySlug(slug),
  getNavCourses(),
]);

if (!course) {
  return Astro.rewrite("/404");
}
---

<BaseLayout
  title={course.seo.title}
  description={course.seo.description}
  keywords={formatSeoKeywords(course.seo.keywords)}
  ogImage={course.seo.ogImage}
  ogType="website"
>
  {course.type === "WORKSHOP" && (
    <Fragment slot="head">
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=JetBrains+Mono:ital,wght@0,400;1,400&family=Roboto:wght@400;500;700&display=swap"
      />
    </Fragment>
  )}
  <CoursePage client:load course={course} navCourses={navCourses} pathname={Astro.url.pathname} />
</BaseLayout>
